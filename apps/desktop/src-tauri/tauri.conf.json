{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kapi",
  "version": "0.1.8",
  "identifier": "com.mehmeturyan.kapi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kapı",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3QTA1REQ4MUVDQTg3NkMKUldSc2g4b2UyRjJnaC9zdjZkUnVBSVFRZ2NUTDlwRGtoUjUrbkgvbmUwUXQ5QWUzUTU4RFRhVUEK",
      "endpoints": [
        "https://github.com/MehmetUryan/kapi/releases/latest/download/latest.json"
      ]
    }
  }
}